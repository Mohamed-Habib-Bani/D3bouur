# API keys / secrets - never commit these
.env
*.env

# Python bytecode cache
__pycache__/
*.pyc

# colcon workspace build output — regenerated by `colcon build`, not source
/build/
/install/
/log/

# Derived/regeneratable, not source content
knowledge_index.json
youtube_extract_draft.json
website_extract_draft.json
src/d3bouur_conversation/staging/

# STT/TTS comparison test artifacts (synthesized/generated audio, not source)
scripts/stt_comparison/test_audio/
scripts/tts_comparison/output_audio/

# Voice/model binaries — large, downloaded via README instructions, not committed
# (READMEs alongside them under models/ are still tracked)
models/**/*.onnx
models/**/*.onnx.json
models/vosk/vosk-model-small-fr-0.22/
models/whisper/ggml-base.bin
# Full whisper.cpp source+build tree (whisper-cli binary is machine-specific,
# not portable to the Pi 5 — see models/whisper/README.md)
models/whisper/whisper.cpp/

# demo_chat.py's spoken output, regenerated each run
src/d3bouur_conversation/spoken_replies/

# Contact form submissions — local data, not source content
src/d3bouur_interface/data/*.db
